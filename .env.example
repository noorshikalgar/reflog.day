# Copy to .env and change. Never commit .env.
PORT=8740
HOST=127.0.0.1
# Folder for reflog.db and backups. Keep it outside the repo in production.
REFLOG_DATA=./data
# IANA time zone for the logical day.
TZ=Asia/Kolkata
# VAPID keys are generated at first start and stored in the database. Do not put them here.
