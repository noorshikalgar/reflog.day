{
  "name": "reflog",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "web",
    "mobile"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev:server": "node --watch --disable-warning=ExperimentalWarning server/src/index.ts",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w web",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning server/src/index.ts",
    "check": "tsc -p tsconfig.json && npm run check -w web && npm run check -w mobile",
    "test": "vitest run",
    "secrets": "node scripts/check-secrets.mjs --all",
    "seed": "node --disable-warning=ExperimentalWarning server/src/seed.ts",
    "dev:mobile": "npm run start -w mobile"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/web-push": "^3.6.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
